<?xml version='1.0' encoding='UTF-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_NexoSoft" targetNamespace="https://nexosoft.example.edu/bpmn">
  <bpmn:message id="Message_Solicitud" name="Solicitud de soporte"/>
  <bpmn:message id="Message_Acuse" name="Acuse de recibo"/>
  <bpmn:message id="Message_PedidoDatos" name="Solicitud de información"/>
  <bpmn:message id="Message_Datos" name="Información adicional"/>
  <bpmn:message id="Message_Solucion" name="Propuesta de solución"/>
  <bpmn:message id="Message_Decision" name="Aceptación o rechazo"/>
  <bpmn:message id="Message_Cierre" name="Confirmación de cierre"/>
  <bpmn:collaboration id="Collaboration_Tickets">
    <bpmn:participant id="Participant_Cliente" name="Cliente (participante externo)"/>
    <bpmn:participant id="Participant_NexoSoft" name="NexoSoft Soluciones SRL" processRef="Process_Tickets"/>
    <bpmn:messageFlow id="MessageFlow_Solicitud" name="Solicitud de soporte" sourceRef="Participant_Cliente" targetRef="Start_Request"/>
    <bpmn:messageFlow id="MessageFlow_Acuse" name="Acuse de recibo" sourceRef="Task_Acknowledge" targetRef="Participant_Cliente"/>
    <bpmn:messageFlow id="MessageFlow_PedidoDatos" name="Solicitud de información" sourceRef="Task_RequestData" targetRef="Participant_Cliente"/>
    <bpmn:messageFlow id="MessageFlow_Datos" name="Información adicional" sourceRef="Participant_Cliente" targetRef="Task_ReceiveData"/>
    <bpmn:messageFlow id="MessageFlow_Solucion" name="Propuesta de solución" sourceRef="Task_Notify" targetRef="Participant_Cliente"/>
    <bpmn:messageFlow id="MessageFlow_Decision" name="Aceptación o rechazo" sourceRef="Participant_Cliente" targetRef="Task_Decision"/>
    <bpmn:messageFlow id="MessageFlow_Cierre" name="Confirmación de cierre" sourceRef="Task_Closure" targetRef="Participant_Cliente"/>
  </bpmn:collaboration>
  <bpmn:process id="Process_Tickets" name="Gestión de tickets y SLA" isExecutable="false">
    <bpmn:documentation>Modelo académico TO-BE no ejecutable. Las fechas límite se calculan desde la creación del ticket con el acuerdo SLA aplicable, calendario y pausas configurados. No fija duraciones contractuales. Las expresiones son conceptuales, no código de un motor.</bpmn:documentation>
    <bpmn:startEvent id="Start_Request" name="Solicitud recibida">
      <bpmn:outgoing>Flow_Start</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Definition_Request" messageRef="Message_Solicitud"/>
    </bpmn:startEvent>
    <bpmn:serviceTask id="Task_Register" name="Registrar ticket y fecha de creación">
      <bpmn:incoming>Flow_Start</bpmn:incoming>
      <bpmn:outgoing>Flow_Config</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_Configure" name="Calcular fechas límite según AcuerdoSLA">
      <bpmn:incoming>Flow_Config</bpmn:incoming>
      <bpmn:outgoing>Flow_Attention</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:subProcess id="SubProcess_Attention" name="Atender ticket — SLA de resolución activo">
      <bpmn:documentation>Incluye primera respuesta, validación, esperas del cliente, atención técnica y aceptación. La alerta de resolución no interrumpe la atención. Las pausas y calendarios pertenecen a la configuración SLA, no se presuponen en este modelo.</bpmn:documentation>
      <bpmn:incoming>Flow_Attention</bpmn:incoming>
      <bpmn:outgoing>Flow_Close</bpmn:outgoing>
      <bpmn:laneSet id="LaneSet_Attention">
        <bpmn:lane id="Lane_Support" name="Soporte">
          <bpmn:flowNodeRef>Start_Attention</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>Task_Acknowledge</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>Task_Validate</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>Gateway_Data</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>Task_RequestData</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>Task_ReceiveData</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>Task_Classify</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>Task_Assign</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>Gateway_Technical</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>Task_Support</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>Gateway_Merge</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>Task_Notify</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>Task_Decision</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>Gateway_Accepted</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>Task_Reopen</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>End_Attention</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>Timer_FirstResponse</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="Lane_Technical" name="Desarrollo y QA">
          <bpmn:flowNodeRef>Task_Develop</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>Task_QA</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>Gateway_QA</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="Lane_System" name="Sistema de Tickets y SLA">
          <bpmn:flowNodeRef>Task_AlertFirst</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="Lane_Projects" name="Gestión de Proyectos">
          <bpmn:flowNodeRef>Task_ReviewFirst</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>End_FirstAlert</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="Start_Attention" name="Iniciar atención">
        <bpmn:outgoing>Flow_Ack</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:sendTask id="Task_Acknowledge" name="Enviar acuse y registrar primera respuesta" messageRef="Message_Acuse">
        <bpmn:incoming>Flow_Ack</bpmn:incoming>
        <bpmn:outgoing>Flow_Validate</bpmn:outgoing>
      </bpmn:sendTask>
      <bpmn:userTask id="Task_Validate" name="Validar cliente, producto y datos">
        <bpmn:incoming>Flow_Validate</bpmn:incoming>
        <bpmn:incoming>Flow_Revalidate</bpmn:incoming>
        <bpmn:outgoing>Flow_Data</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:exclusiveGateway id="Gateway_Data" name="¿Datos completos?" default="Flow_DataNo">
        <bpmn:incoming>Flow_Data</bpmn:incoming>
        <bpmn:outgoing>Flow_DataYes</bpmn:outgoing>
        <bpmn:outgoing>Flow_DataNo</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:sendTask id="Task_RequestData" name="Solicitar información" messageRef="Message_PedidoDatos">
        <bpmn:incoming>Flow_DataNo</bpmn:incoming>
        <bpmn:outgoing>Flow_ReceiveData</bpmn:outgoing>
      </bpmn:sendTask>
      <bpmn:receiveTask id="Task_ReceiveData" name="Recibir información adicional" messageRef="Message_Datos">
        <bpmn:incoming>Flow_ReceiveData</bpmn:incoming>
        <bpmn:outgoing>Flow_Revalidate</bpmn:outgoing>
      </bpmn:receiveTask>
      <bpmn:userTask id="Task_Classify" name="Clasificar y priorizar">
        <bpmn:incoming>Flow_DataYes</bpmn:incoming>
        <bpmn:outgoing>Flow_Assign</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="Task_Assign" name="Asignar responsable">
        <bpmn:incoming>Flow_Assign</bpmn:incoming>
        <bpmn:outgoing>Flow_Technical</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:exclusiveGateway id="Gateway_Technical" name="¿Intervención técnica?" default="Flow_Support">
        <bpmn:incoming>Flow_Technical</bpmn:incoming>
        <bpmn:incoming>Flow_Reopen</bpmn:incoming>
        <bpmn:outgoing>Flow_Support</bpmn:outgoing>
        <bpmn:outgoing>Flow_Develop</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:userTask id="Task_Support" name="Resolver en Soporte">
        <bpmn:incoming>Flow_Support</bpmn:incoming>
        <bpmn:outgoing>Flow_SupportMerge</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="Task_Develop" name="Analizar y corregir">
        <bpmn:incoming>Flow_Develop</bpmn:incoming>
        <bpmn:incoming>Flow_QANo</bpmn:incoming>
        <bpmn:outgoing>Flow_QA</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="Task_QA" name="Verificar solución">
        <bpmn:incoming>Flow_QA</bpmn:incoming>
        <bpmn:outgoing>Flow_CheckQA</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:exclusiveGateway id="Gateway_QA" name="¿Verificación conforme?" default="Flow_QANo">
        <bpmn:incoming>Flow_CheckQA</bpmn:incoming>
        <bpmn:outgoing>Flow_QAYes</bpmn:outgoing>
        <bpmn:outgoing>Flow_QANo</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:exclusiveGateway id="Gateway_Merge" name="Unificar atención">
        <bpmn:incoming>Flow_QAYes</bpmn:incoming>
        <bpmn:incoming>Flow_SupportMerge</bpmn:incoming>
        <bpmn:outgoing>Flow_Notify</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:sendTask id="Task_Notify" name="Comunicar propuesta de solución" messageRef="Message_Solucion">
        <bpmn:incoming>Flow_Notify</bpmn:incoming>
        <bpmn:outgoing>Flow_Decision</bpmn:outgoing>
      </bpmn:sendTask>
      <bpmn:receiveTask id="Task_Decision" name="Recibir aceptación o rechazo" messageRef="Message_Decision">
        <bpmn:incoming>Flow_Decision</bpmn:incoming>
        <bpmn:outgoing>Flow_Accepted</bpmn:outgoing>
      </bpmn:receiveTask>
      <bpmn:exclusiveGateway id="Gateway_Accepted" name="¿Solución aceptada?" default="Flow_AcceptNo">
        <bpmn:incoming>Flow_Accepted</bpmn:incoming>
        <bpmn:outgoing>Flow_AcceptYes</bpmn:outgoing>
        <bpmn:outgoing>Flow_AcceptNo</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:userTask id="Task_Reopen" name="Registrar rechazo y retomar atención">
        <bpmn:incoming>Flow_AcceptNo</bpmn:incoming>
        <bpmn:outgoing>Flow_Reopen</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="End_Attention" name="Resolución aceptada">
        <bpmn:incoming>Flow_AcceptYes</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:boundaryEvent id="Timer_FirstResponse" name="Límite de primera respuesta" attachedToRef="Task_Acknowledge" cancelActivity="false">
        <bpmn:outgoing>Flow_FirstAlert</bpmn:outgoing>
        <bpmn:timerEventDefinition id="Definition_FirstResponse">
          <bpmn:timeDate xsi:type="bpmn:tFormalExpression" language="urn:nexosoft:conceptual">sla.fechaLimitePrimeraRespuesta</bpmn:timeDate>
        </bpmn:timerEventDefinition>
      </bpmn:boundaryEvent>
      <bpmn:serviceTask id="Task_AlertFirst" name="Registrar y notificar incumplimiento de primera respuesta">
        <bpmn:incoming>Flow_FirstAlert</bpmn:incoming>
        <bpmn:outgoing>Flow_FirstReview</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="Task_ReviewFirst" name="Gestión de Proyectos: evaluar alerta y coordinar acción">
        <bpmn:incoming>Flow_FirstReview</bpmn:incoming>
        <bpmn:outgoing>Flow_FirstDone</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="End_FirstAlert" name="Alerta atendida">
        <bpmn:incoming>Flow_FirstDone</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_Ack" sourceRef="Start_Attention" targetRef="Task_Acknowledge"/>
      <bpmn:sequenceFlow id="Flow_Validate" sourceRef="Task_Acknowledge" targetRef="Task_Validate"/>
      <bpmn:sequenceFlow id="Flow_Data" sourceRef="Task_Validate" targetRef="Gateway_Data"/>
      <bpmn:sequenceFlow id="Flow_DataYes" sourceRef="Gateway_Data" targetRef="Task_Classify" name="Sí">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" language="urn:nexosoft:conceptual">datos.completos</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_DataNo" sourceRef="Gateway_Data" targetRef="Task_RequestData" name="No"/>
      <bpmn:sequenceFlow id="Flow_ReceiveData" sourceRef="Task_RequestData" targetRef="Task_ReceiveData"/>
      <bpmn:sequenceFlow id="Flow_Revalidate" sourceRef="Task_ReceiveData" targetRef="Task_Validate"/>
      <bpmn:sequenceFlow id="Flow_Assign" sourceRef="Task_Classify" targetRef="Task_Assign"/>
      <bpmn:sequenceFlow id="Flow_Technical" sourceRef="Task_Assign" targetRef="Gateway_Technical"/>
      <bpmn:sequenceFlow id="Flow_Support" sourceRef="Gateway_Technical" targetRef="Task_Support" name="No"/>
      <bpmn:sequenceFlow id="Flow_Develop" sourceRef="Gateway_Technical" targetRef="Task_Develop" name="Sí">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" language="urn:nexosoft:conceptual">ticket.requiereIntervencionTecnica</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_QA" sourceRef="Task_Develop" targetRef="Task_QA"/>
      <bpmn:sequenceFlow id="Flow_CheckQA" sourceRef="Task_QA" targetRef="Gateway_QA"/>
      <bpmn:sequenceFlow id="Flow_QAYes" sourceRef="Gateway_QA" targetRef="Gateway_Merge" name="Sí">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" language="urn:nexosoft:conceptual">verificacion.conforme</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_QANo" sourceRef="Gateway_QA" targetRef="Task_Develop" name="No"/>
      <bpmn:sequenceFlow id="Flow_SupportMerge" sourceRef="Task_Support" targetRef="Gateway_Merge"/>
      <bpmn:sequenceFlow id="Flow_Notify" sourceRef="Gateway_Merge" targetRef="Task_Notify"/>
      <bpmn:sequenceFlow id="Flow_Decision" sourceRef="Task_Notify" targetRef="Task_Decision"/>
      <bpmn:sequenceFlow id="Flow_Accepted" sourceRef="Task_Decision" targetRef="Gateway_Accepted"/>
      <bpmn:sequenceFlow id="Flow_AcceptYes" sourceRef="Gateway_Accepted" targetRef="End_Attention" name="Sí">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" language="urn:nexosoft:conceptual">respuestaCliente.aceptada</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_AcceptNo" sourceRef="Gateway_Accepted" targetRef="Task_Reopen" name="No"/>
      <bpmn:sequenceFlow id="Flow_Reopen" sourceRef="Task_Reopen" targetRef="Gateway_Technical"/>
      <bpmn:sequenceFlow id="Flow_FirstAlert" sourceRef="Timer_FirstResponse" targetRef="Task_AlertFirst"/>
      <bpmn:sequenceFlow id="Flow_FirstReview" sourceRef="Task_AlertFirst" targetRef="Task_ReviewFirst"/>
      <bpmn:sequenceFlow id="Flow_FirstDone" sourceRef="Task_ReviewFirst" targetRef="End_FirstAlert"/>
    </bpmn:subProcess>
    <bpmn:serviceTask id="Task_Close" name="Cerrar ticket y actualizar historial e indicadores">
      <bpmn:incoming>Flow_Close</bpmn:incoming>
      <bpmn:outgoing>Flow_Closure</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="Task_Closure" name="Notificar cierre al cliente" messageRef="Message_Cierre">
      <bpmn:incoming>Flow_Closure</bpmn:incoming>
      <bpmn:outgoing>Flow_End</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="End_Ticket" name="Ticket cerrado">
      <bpmn:incoming>Flow_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:boundaryEvent id="Timer_Resolution" name="Límite de resolución" attachedToRef="SubProcess_Attention" cancelActivity="false">
      <bpmn:outgoing>Flow_ResolutionAlert</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Definition_Resolution">
        <bpmn:timeDate xsi:type="bpmn:tFormalExpression" language="urn:nexosoft:conceptual">sla.fechaLimiteResolucion</bpmn:timeDate>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:serviceTask id="Task_AlertResolution" name="Sistema: registrar y notificar incumplimiento de resolución">
      <bpmn:incoming>Flow_ResolutionAlert</bpmn:incoming>
      <bpmn:outgoing>Flow_ResolutionReview</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Task_ReviewResolution" name="Gestión de Proyectos: evaluar alerta y coordinar acción">
      <bpmn:incoming>Flow_ResolutionReview</bpmn:incoming>
      <bpmn:outgoing>Flow_ResolutionDone</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="End_ResolutionAlert" name="Alerta atendida">
      <bpmn:incoming>Flow_ResolutionDone</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_Start" sourceRef="Start_Request" targetRef="Task_Register"/>
    <bpmn:sequenceFlow id="Flow_Config" sourceRef="Task_Register" targetRef="Task_Configure"/>
    <bpmn:sequenceFlow id="Flow_Attention" sourceRef="Task_Configure" targetRef="SubProcess_Attention"/>
    <bpmn:sequenceFlow id="Flow_Close" sourceRef="SubProcess_Attention" targetRef="Task_Close"/>
    <bpmn:sequenceFlow id="Flow_Closure" sourceRef="Task_Close" targetRef="Task_Closure"/>
    <bpmn:sequenceFlow id="Flow_End" sourceRef="Task_Closure" targetRef="End_Ticket"/>
    <bpmn:sequenceFlow id="Flow_ResolutionAlert" sourceRef="Timer_Resolution" targetRef="Task_AlertResolution"/>
    <bpmn:sequenceFlow id="Flow_ResolutionReview" sourceRef="Task_AlertResolution" targetRef="Task_ReviewResolution"/>
    <bpmn:sequenceFlow id="Flow_ResolutionDone" sourceRef="Task_ReviewResolution" targetRef="End_ResolutionAlert"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_Tickets">
    <bpmndi:BPMNPlane id="Plane_Tickets" bpmnElement="Collaboration_Tickets">
      <bpmndi:BPMNShape id="DI_Participant_Cliente" bpmnElement="Participant_Cliente" isHorizontal="true">
        <dc:Bounds x="170" y="40" width="4020" height="90"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_Participant_NexoSoft" bpmnElement="Participant_NexoSoft" isHorizontal="true">
        <dc:Bounds x="170" y="180" width="4020" height="1620"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_SubProcess_Attention" bpmnElement="SubProcess_Attention" isExpanded="true">
        <dc:Bounds x="200" y="400" width="3240" height="1100"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_Lane_Support" bpmnElement="Lane_Support" isHorizontal="true">
        <dc:Bounds x="230" y="440" width="3210" height="510"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_Lane_Technical" bpmnElement="Lane_Technical" isHorizontal="true">
        <dc:Bounds x="230" y="950" width="3210" height="170"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_Lane_System" bpmnElement="Lane_System" isHorizontal="true">
        <dc:Bounds x="230" y="1120" width="3210" height="180"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_Lane_Projects" bpmnElement="Lane_Projects" isHorizontal="true">
        <dc:Bounds x="230" y="1300" width="3210" height="200"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_Start_Request" bpmnElement="Start_Request">
        <dc:Bounds x="220" y="235" width="36" height="36"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="175" y="279" width="140" height="40"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_Task_Register" bpmnElement="Task_Register">
        <dc:Bounds x="1000" y="218" width="150" height="70"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_Task_Configure" bpmnElement="Task_Configure">
        <dc:Bounds x="1220" y="218" width="150" height="70"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_Start_Attention" bpmnElement="Start_Attention">
        <dc:Bounds x="290" y="522" width="36" height="36"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="245" y="566" width="140" height="40"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_Task_Acknowledge" bpmnElement="Task_Acknowledge">
        <dc:Bounds x="380" y="505" width="150" height="70"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_Task_Validate" bpmnElement="Task_Validate">
        <dc:Bounds x="610" y="505" width="150" height="70"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_Gateway_Data" bpmnElement="Gateway_Data" isMarkerVisible="true">
        <dc:Bounds x="820" y="515" width="50" height="50"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="775" y="573" width="140" height="40"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_Task_RequestData" bpmnElement="Task_RequestData">
        <dc:Bounds x="750" y="700" width="150" height="70"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_Task_ReceiveData" bpmnElement="Task_ReceiveData">
        <dc:Bounds x="520" y="700" width="150" height="70"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_Task_Classify" bpmnElement="Task_Classify">
        <dc:Bounds x="970" y="505" width="150" height="70"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_Task_Assign" bpmnElement="Task_Assign">
        <dc:Bounds x="1180" y="505" width="150" height="70"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_Gateway_Technical" bpmnElement="Gateway_Technical" isMarkerVisible="true">
        <dc:Bounds x="1400" y="515" width="50" height="50"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1355" y="573" width="140" height="40"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_Task_Support" bpmnElement="Task_Support">
        <dc:Bounds x="1550" y="505" width="150" height="70"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_Task_Develop" bpmnElement="Task_Develop">
        <dc:Bounds x="1430" y="1000" width="150" height="70"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_Task_QA" bpmnElement="Task_QA">
