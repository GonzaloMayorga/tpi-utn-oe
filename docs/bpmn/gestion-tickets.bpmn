<?xml version='1.0' encoding='UTF-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_NexoSoft" targetNamespace="https://nexosoft.example.edu/bpmn">
  <bpmn:collaboration id="Collaboration_Tickets">
    <bpmn:participant id="Participant_Cliente" name="Cliente (externo)"/>
    <bpmn:participant id="Participant_NexoSoft" name="NexoSoft Soluciones SRL" processRef="Process_Tickets"/>
    <bpmn:messageFlow id="MessageFlow_Cliente" name="Solicitud de soporte" sourceRef="Participant_Cliente" targetRef="Task_start"/>
  </bpmn:collaboration>
  <bpmn:process id="Process_Tickets" name="Gestión de tickets y SLA" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_Soporte" name="Soporte">
        <bpmn:flowNodeRef>Task_validate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_complete</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_request</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_receive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_classify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_assign</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_needs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_resolve_support</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_notify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_accepted</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_reopen</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Sistema" name="Sistema de Tickets y SLA">
        <bpmn:flowNodeRef>Task_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_register</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_sla</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_close</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_end</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Tecnico" name="Desarrollo y QA">
        <bpmn:flowNodeRef>Task_resolve_tech</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_qa</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Timer_SLA</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Proyectos" name="Gestión de Proyectos">
        <bpmn:flowNodeRef>Task_escalate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_escalate_end</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Task_start" name="Solicitud recibida">
      <bpmn:messageEventDefinition id="MsgEvent_Start"/>
    </bpmn:startEvent>
    <bpmn:serviceTask id="Task_register" name="Registrar ticket"/>
    <bpmn:userTask id="Task_validate" name="Validar datos"/>
    <bpmn:exclusiveGateway id="Task_complete" name="¿Datos completos?"/>
    <bpmn:sendTask id="Task_request" name="Solicitar información"/>
    <bpmn:receiveTask id="Task_receive" name="Recibir información"/>
    <bpmn:userTask id="Task_classify" name="Clasificar y priorizar"/>
    <bpmn:serviceTask id="Task_sla" name="Consultar SLA"/>
    <bpmn:userTask id="Task_assign" name="Asignar responsable"/>
    <bpmn:exclusiveGateway id="Task_needs" name="¿Derivación técnica?"/>
    <bpmn:userTask id="Task_resolve_support" name="Resolver en Soporte"/>
    <bpmn:userTask id="Task_resolve_tech" name="Analizar y corregir"/>
    <bpmn:userTask id="Task_qa" name="Verificar solución"/>
    <bpmn:exclusiveGateway id="Task_merge" name="Convergencia"/>
    <bpmn:sendTask id="Task_notify" name="Comunicar solución"/>
    <bpmn:exclusiveGateway id="Task_accepted" name="¿Solución aceptada?"/>
    <bpmn:userTask id="Task_reopen" name="Reabrir ticket"/>
    <bpmn:serviceTask id="Task_close" name="Cerrar y actualizar métricas"/>
    <bpmn:endEvent id="Task_end" name="Ticket cerrado"/>
    <bpmn:userTask id="Task_escalate" name="Revisar vencimiento SLA"/>
    <bpmn:endEvent id="Task_escalate_end" name="Escalamiento registrado"/>
    <bpmn:boundaryEvent id="Timer_SLA" name="Umbral SLA alcanzado" attachedToRef="Task_resolve_tech" cancelActivity="false">
      <bpmn:timerEventDefinition id="Timer_Def_SLA"><bpmn:timeDuration xsi:type="b:tFormalExpression">PT1H</bpmn:timeDuration></bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Task_start" targetRef="Task_register"/>
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_register" targetRef="Task_validate"/>
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_validate" targetRef="Task_complete"/>
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Task_complete" targetRef="Task_classify" name="Sí"/>
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Task_complete" targetRef="Task_request" name="No"/>
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Task_request" targetRef="Task_receive"/>
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Task_receive" targetRef="Task_validate"/>
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Task_classify" targetRef="Task_sla"/>
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Task_sla" targetRef="Task_assign"/>
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Task_assign" targetRef="Task_needs"/>
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Task_needs" targetRef="Task_resolve_support" name="No"/>
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Task_needs" targetRef="Task_resolve_tech" name="Sí"/>
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Task_resolve_support" targetRef="Task_merge"/>
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Task_resolve_tech" targetRef="Task_qa"/>
    <bpmn:sequenceFlow id="Flow_15" sourceRef="Task_qa" targetRef="Task_merge"/>
    <bpmn:sequenceFlow id="Flow_16" sourceRef="Task_merge" targetRef="Task_notify"/>
    <bpmn:sequenceFlow id="Flow_17" sourceRef="Task_notify" targetRef="Task_accepted"/>
    <bpmn:sequenceFlow id="Flow_18" sourceRef="Task_accepted" targetRef="Task_close" name="Sí"/>
    <bpmn:sequenceFlow id="Flow_19" sourceRef="Task_accepted" targetRef="Task_reopen" name="No"/>
    <bpmn:sequenceFlow id="Flow_20" sourceRef="Task_reopen" targetRef="Task_resolve_support"/>
    <bpmn:sequenceFlow id="Flow_21" sourceRef="Task_close" targetRef="Task_end"/>
    <bpmn:sequenceFlow id="Flow_SLA" sourceRef="Timer_SLA" targetRef="Task_escalate"/>
    <bpmn:sequenceFlow id="Flow_SLA_End" sourceRef="Task_escalate" targetRef="Task_escalate_end"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_1">
